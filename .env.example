# ===========================================
# DOCKER COMPOSE CONFIGURATION
# ===========================================

# PostgreSQL Configuration
POSTGRES_DB=shopnow
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=3000
NODE_ENV=production

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Database URL (update with your credentials)
DATABASE_URL=postgresql://admin:your_secure_password_here@localhost:5432/shopnow

# Redis URL
REDIS_URL=redis://localhost:6379

# Frontend URL
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# ===========================================
# AWS CONFIGURATION
# ===========================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ===========================================
# SECURITY
# ===========================================

JWT_SECRET=generate_random_secret_here
SESSION_SECRET=generate_random_secret_here
ENCRYPTION_KEY=generate_random_secret_here

# ===========================================
# MONITORING & LOGGING
# ===========================================

LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace all placeholder values with real credentials
# 3. Never commit .env to Git (already in .gitignore)
# 4. For production, use AWS Secrets Manager instead
# ===========================================
